FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# For local development, set GOOGLE_APPLICATION_CREDENTIALS to your private service-account JSON file path.
# On Render, set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON contents as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OPENAI_API_KEY=
