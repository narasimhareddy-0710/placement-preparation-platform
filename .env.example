FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to your private Firebase service-account JSON file (local Docker only).
FIREBASE_SERVICE_ACCOUNT_FILE=C:/path/to/firebase-service-account.json
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE
# Optional; AI interview feedback stays disabled until this is set server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
